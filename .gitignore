# Saves never belong in the repo. They live in %LOCALAPPDATA%\SEED\, which is
# per-user, so everyone who clones this gets their own world automatically.
# These patterns are here only in case someone runs a portable build.
savegame.json
savegame_backup.json
savegame.tmp
*.sav

